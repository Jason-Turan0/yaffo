# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environment
.venv/
env/
venv/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# PyCharm
.idea/
*.iml

# VS Code
.vscode/

# Flask instance folder
instance/

# Pytest cache
.pytest_cache/

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Mac system files
.DS_Store

# Thumbnails / temporary files
*.tmp
*.temp

# Test data
yaffo/scripts/test_data/
yaffo/scripts/performance_profiles/

# Bundled assets (exiftool + ML models) — fetched by packaging/download_assets.py
resources/*

# Packaging build artifacts
*.app
*.dmg
packaging/icon.icns  # generated from the app SVG by packaging/make_icons.sh

# Generated build stamp (version + timestamp) written by packaging/bump_version.py
yaffo/_build_info.py
node_modules

# Environment files with secrets
.env
.env.local
.env.*.local

# Terraform (GCP deploy)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*tfplan*
crash.log
crash.*.log
# keep the example tfvars and the provider lock file tracked
!deploy/gcp/terraform.tfvars.example
!deploy/hub/terraform.tfvars.example
!**/.terraform.lock.hcl

# Playwright
yaffo_ui_tests/reports/
yaffo_ui_tests/.playwright/
model_logs
# MkDocs build output
site/

# Vitest frontend coverage output
tests_js/coverage/
