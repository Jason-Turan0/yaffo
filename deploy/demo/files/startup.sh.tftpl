#!/bin/bash
# Yaffo demo VM bootstrap. GCE runs this on EVERY boot (including the daily
# Cloud Scheduler start), so every step is idempotent. It prepares everything
# code-independent (disk, secrets, admin access, the pinned Compose plugin),
# writes out restore-golden.sh (below), and runs it — which is the actual
# daily reset: restore both devices from the golden state and bring the
# containers up, authenticating Docker against Artifact Registry first.
#
# The application bundle (compose.prod.yml, Caddyfile, walkthrough, .env) and
# the golden state itself arrive separately via deploy.sh/seed-prod.sh/
# save-golden-prod.sh, the same infra/code split as deploy/hub. A brand-new VM
# has neither yet on its first boot, so restore-golden.sh's steps are each
# skipped with a message — expected and harmless.
set -euo pipefail

DATA_DEVICE="/dev/disk/by-id/google-${disk_name}"
DATA_ROOT="/var/lib/yaffo-demo"
COMPOSE_VERSION="${docker_compose_version}"
COMPOSE_SHA256="${docker_compose_linux_x86_64_sha256}"
COMPOSE_PLUGIN="/var/lib/yaffo-demo/bin/docker-compose"

# --- Data disk ------------------------------------------------------------------
for attempt in $(seq 1 30); do
    if [[ -b "$DATA_DEVICE" ]]; then
        break
    fi
    sleep 1
done

if [[ ! -b "$DATA_DEVICE" ]]; then
    echo "Demo data disk did not appear: $DATA_DEVICE" >&2
    exit 1
fi

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    mkfs.ext4 -F "$DATA_DEVICE"
fi

mkdir -p "$DATA_ROOT"
if ! mountpoint -q "$DATA_ROOT"; then
    mount -o nodev,nosuid "$DATA_DEVICE" "$DATA_ROOT"
fi

mkdir -p \
    "$DATA_ROOT/a" \
    "$DATA_ROOT/b" \
    "$DATA_ROOT/bin" \
    "$DATA_ROOT/deploy" \
    "$DATA_ROOT/fixtures/a" \
    "$DATA_ROOT/fixtures/b" \
    "$DATA_ROOT/golden" \
    "$DATA_ROOT/identities/a" \
    "$DATA_ROOT/identities/b" \
    "$DATA_ROOT/secrets"

chown -R 10001:10001 "$DATA_ROOT/a" "$DATA_ROOT/b" "$DATA_ROOT/identities"
chmod 0750 "$DATA_ROOT" "$DATA_ROOT/a" "$DATA_ROOT/b" "$DATA_ROOT/identities"
chmod 0755 "$DATA_ROOT/fixtures" "$DATA_ROOT/fixtures/a" "$DATA_ROOT/fixtures/b"
chmod 0700 "$DATA_ROOT/secrets"

for name in demo-a-flask-secret demo-b-flask-secret; do
    secret="$DATA_ROOT/secrets/$name"
    if [[ ! -f "$secret" ]]; then
        { od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; echo; } > "$secret"
    fi
    chown 10001:10001 "$secret"
    chmod 0600 "$secret"
done

# --- Admin SSH user ---------------------------------------------------------------
# Container-Optimized OS has no useradd/getent/sudoers tooling (deploy/hub's
# static-user-provisioning approach is Debian-only and fails outright here —
# `set -euo pipefail` turned that failure into "the rest of this script never
# ran, no containers ever start"). COS's actual supported mechanism is GCE's
# own instance-metadata `ssh-keys` field: the guest agent (present and
# running by default on COS) creates the user, home directory, and
# authorized_keys automatically the first time that user connects. See the
# `ssh-keys` entry in google_compute_instance.demo's metadata in main.tf —
# nothing to do here.

# --- Pinned Docker Compose plugin ------------------------------------------------
# COS ships Docker but no general-purpose package manager, so Compose is
# fetched and checksummed here instead of apt-installed (contrast deploy/hub,
# which is Debian and just apt-installs Caddy).
if [[ ! -x "$COMPOSE_PLUGIN" ]]; then
    temporary="$COMPOSE_PLUGIN.tmp"
    curl --fail --location --silent --show-error \
        "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
        --output "$temporary"
    echo "$COMPOSE_SHA256  $temporary" | sha256sum --check --status
    chmod 0755 "$temporary"
    mv "$temporary" "$COMPOSE_PLUGIN"
fi

echo "Yaffo demo host storage, admin access, and pinned Compose plugin are ready."

# --- Golden-state restore + container startup ------------------------------------
# Written fresh on every boot so it's always current with the Terraform
# source (same pattern as deploy/hub's Caddyfile/unit-file heredocs). This is
# the actual daily reset — GCE runs the startup script on every boot,
# including the scheduled 7:45 AM start.
cat > "$DATA_ROOT/bin/restore-golden.sh" <<'RESTORE_GOLDEN'
${restore_golden_script}
RESTORE_GOLDEN
chmod 0755 "$DATA_ROOT/bin/restore-golden.sh"

"$DATA_ROOT/bin/restore-golden.sh"
