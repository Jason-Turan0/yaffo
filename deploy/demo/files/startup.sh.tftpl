#!/bin/bash
# Yaffo demo VM bootstrap. GCE runs this on EVERY boot (including the daily
# Cloud Scheduler start), so every step is idempotent. It prepares everything
# code-independent (disk, secrets, admin access, the pinned Compose plugin)
# and then — unlike the previous version of this config — actually brings
# the containers up, authenticating Docker against Artifact Registry first.
#
# The application bundle (compose.prod.yml, Caddyfile, walkthrough, .env)
# arrives separately via deploy.sh, the same split as deploy/hub. A brand-new
# VM has no bundle yet on its first boot, so container startup is skipped
# with a message — expected and harmless; run deploy.sh once, then this
# script brings the same bundle back up on every subsequent boot.
set -euo pipefail

DATA_DEVICE="/dev/disk/by-id/google-${disk_name}"
DATA_ROOT="/var/lib/yaffo-demo"
COMPOSE_VERSION="${docker_compose_version}"
COMPOSE_SHA256="${docker_compose_linux_x86_64_sha256}"
COMPOSE_PLUGIN="/var/lib/yaffo-demo/bin/docker-compose"

# --- Data disk ------------------------------------------------------------------
for attempt in $(seq 1 30); do
    if [[ -b "$DATA_DEVICE" ]]; then
        break
    fi
    sleep 1
done

if [[ ! -b "$DATA_DEVICE" ]]; then
    echo "Demo data disk did not appear: $DATA_DEVICE" >&2
    exit 1
fi

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    mkfs.ext4 -F "$DATA_DEVICE"
fi

mkdir -p "$DATA_ROOT"
if ! mountpoint -q "$DATA_ROOT"; then
    mount -o nodev,nosuid "$DATA_DEVICE" "$DATA_ROOT"
fi

mkdir -p \
    "$DATA_ROOT/a" \
    "$DATA_ROOT/b" \
    "$DATA_ROOT/bin" \
    "$DATA_ROOT/deploy" \
    "$DATA_ROOT/fixtures/a" \
    "$DATA_ROOT/fixtures/b" \
    "$DATA_ROOT/identities/a" \
    "$DATA_ROOT/identities/b" \
    "$DATA_ROOT/secrets"

chown -R 10001:10001 "$DATA_ROOT/a" "$DATA_ROOT/b" "$DATA_ROOT/identities"
chmod 0750 "$DATA_ROOT" "$DATA_ROOT/a" "$DATA_ROOT/b" "$DATA_ROOT/identities"
chmod 0755 "$DATA_ROOT/fixtures" "$DATA_ROOT/fixtures/a" "$DATA_ROOT/fixtures/b"
chmod 0700 "$DATA_ROOT/secrets"

for name in demo-a-flask-secret demo-b-flask-secret; do
    secret="$DATA_ROOT/secrets/$name"
    if [[ ! -f "$secret" ]]; then
        od -An -N32 -tx1 /dev/urandom | tr -d ' \n' > "$secret"
    fi
    chmod 0600 "$secret"
done

# --- Admin SSH user (static authorized_keys, independent of the guest agent) --
# Same lesson as deploy/hub: GCE's metadata-based/OS-Login key lookup has
# proven unreliable, and a VM you can't SSH into can't be operated.
%{ if admin_ssh_user != "" && admin_ssh_pubkey != "" ~}
if ! id '${admin_ssh_user}' >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash '${admin_ssh_user}'
  usermod -aG google-sudoers '${admin_ssh_user}' 2>/dev/null || echo '${admin_ssh_user} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-${admin_ssh_user}
fi
ADMIN_HOME=$(getent passwd '${admin_ssh_user}' | cut -d: -f6)
mkdir -p "$ADMIN_HOME/.ssh"
grep -qxF '${admin_ssh_pubkey}' "$ADMIN_HOME/.ssh/authorized_keys" 2>/dev/null || echo '${admin_ssh_pubkey}' >> "$ADMIN_HOME/.ssh/authorized_keys"
chmod 700 "$ADMIN_HOME/.ssh"
chmod 600 "$ADMIN_HOME/.ssh/authorized_keys"
chown -R '${admin_ssh_user}:${admin_ssh_user}' "$ADMIN_HOME/.ssh"
%{ endif ~}

# --- Pinned Docker Compose plugin ------------------------------------------------
# COS ships Docker but no general-purpose package manager, so Compose is
# fetched and checksummed here instead of apt-installed (contrast deploy/hub,
# which is Debian and just apt-installs Caddy).
if [[ ! -x "$COMPOSE_PLUGIN" ]]; then
    temporary="$COMPOSE_PLUGIN.tmp"
    curl --fail --location --silent --show-error \
        "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
        --output "$temporary"
    echo "$COMPOSE_SHA256  $temporary" | sha256sum --check --status
    chmod 0755 "$temporary"
    mv "$temporary" "$COMPOSE_PLUGIN"
fi

echo "Yaffo demo host storage, admin access, and pinned Compose plugin are ready."

# --- Bring the containers up -----------------------------------------------------
# The bundle (compose.prod.yml, Caddyfile, walkthrough, .env) is placed here
# by deploy.sh, not by this script — Terraform owns infrastructure, deploy.sh
# owns code delivery, same split as deploy/hub.
BUNDLE="$DATA_ROOT/deploy/compose.prod.yml"
if [[ ! -f "$BUNDLE" ]]; then
    echo "No deploy bundle at $BUNDLE yet — skipping container startup."
    echo "Run deploy/demo/deploy.sh once to push it, then it starts on every boot."
    exit 0
fi

docker-credential-gcr configure-docker --registries='${registry_host}'

cd "$DATA_ROOT/deploy"
"$COMPOSE_PLUGIN" --env-file .env -f compose.prod.yml pull
"$COMPOSE_PLUGIN" --env-file .env -f compose.prod.yml up --detach --remove-orphans
"$COMPOSE_PLUGIN" --env-file .env -f compose.prod.yml ps

echo "Containers started."
