# Copy to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars is gitignored (it pins your real project id).
# Anything with a default in variables.tf can be omitted here.

project_id = "your-gcp-project-id"
region     = "us-central1"
zone       = "us-central1-a"

# Optional overrides (defaults shown):
# ar_repo      = "yaffo"
# disk_name    = "yaffo-data"
# disk_size_gb = 50
# disk_type    = "pd-balanced"
# vm_name      = "yaffo"
# machine_type = "e2-standard-4"
# vm_tag       = "yaffo"