project_id          = "your-gcp-project-id"
billing_account_id  = "000000-000000-000000"
budget_alert_email  = "operator@example.com"

region = "us-central1"
zone   = "us-central1-a"

walkthrough_domain = "demo.yaffo.app"
demo_a_domain      = "demo-a.yaffo.app"
demo_b_domain      = "demo-b.yaffo.app"
hub_url            = "wss://hub.yaffo.app"

# Copy the checksum published beside this exact release asset. Terraform refuses
# a placeholder or malformed value, and the VM refuses a mismatched download.
docker_compose_version                 = "v5.1.4"
docker_compose_linux_x86_64_sha256     = "replace-with-the-published-64-character-sha256"

# Optional overrides (defaults shown):
# machine_type          = "e2-medium"
# disk_size_gb          = 50
# monthly_budget_usd    = 50
# image_versions_to_keep = 3
# vm_start_cron         = "45 7 * * *"
# vm_stop_cron          = "0 22 * * *"
# schedule_timezone     = "America/Chicago"
