#: yaffo/background_tasks/automation_config.py:66
msgid "Threshold"
msgstr "Umbral"

#: yaffo/background_tasks/automation_config.py:67
msgid "Low finds more faces, Medium is balanced, and High keeps only more confident faces."
msgstr ""
"Bajo encuentra más rostros, Medio es equilibrado y Alto conserva solo los rostros con mayor "
"confianza."

#: yaffo/background_tasks/automation_config.py:73
msgid "Low"
msgstr "Bajo"

#: yaffo/background_tasks/automation_config.py:74
msgid "More sensitive; finds more weak, small, blurry, or side-angle faces, but may add false positives."
msgstr ""
"Más sensible; encuentra más rostros débiles, pequeños, borrosos o en ángulo lateral, pero puede "
"añadir falsos positivos."

#: yaffo/background_tasks/automation_config.py:78
msgid "Medium"
msgstr "Medio"

#: yaffo/background_tasks/automation_config.py:79
msgid "Balanced default for normal library indexing."
msgstr "Valor predeterminado equilibrado para la indexación normal de la biblioteca."

#: yaffo/background_tasks/automation_config.py:83
msgid "High"
msgstr "Alto"

#: yaffo/background_tasks/automation_config.py:84
msgid "Stricter; keeps fewer, more confident faces and may miss harder faces."
msgstr ""
"Más estricto; conserva menos rostros pero con mayor confianza y puede omitir rostros más "
"difíciles de detectar."

#: yaffo/background_tasks/automation_config.py:90
msgid "Scan Speed"
msgstr "Velocidad de escaneo"

#: yaffo/background_tasks/automation_config.py:92
msgid ""
"Fast scans quickest, Balanced keeps the default behavior, and Thorough is slower but better at "
"finding small or distant faces."
msgstr ""
"Rápido escanea más rápido, Equilibrado mantiene el comportamiento predeterminado y Exhaustivo es "
"más lento pero mejor para encontrar rostros pequeños o lejanos."

#: yaffo/background_tasks/automation_config.py:99
msgid "Fast"
msgstr "Rápido"

#: yaffo/background_tasks/automation_config.py:100
msgid "Faster scans that may miss small or distant faces."
msgstr "Escaneos más rápidos que pueden omitir rostros pequeños o lejanos."

#: yaffo/background_tasks/automation_config.py:104
msgid "Balanced"
msgstr "Equilibrado"

#: yaffo/background_tasks/automation_config.py:105
msgid "Balanced default for detection quality and scan speed."
msgstr "Valor predeterminado equilibrado entre calidad de detección y velocidad de escaneo."

#: yaffo/background_tasks/automation_config.py:109
msgid "Thorough"
msgstr "Exhaustivo"

#: yaffo/background_tasks/automation_config.py:110
msgid "Slower scans with better detection for small or distant faces."
msgstr "Escaneos más lentos con mejor detección para rostros pequeños o lejanos."

#: yaffo/background_tasks/automation_config.py:118
msgid "Match threshold"
msgstr "Umbral de coincidencia"

#: yaffo/background_tasks/automation_config.py:120
msgid ""
"Threshold to use when comparing faces (0 = least similar, 100 = most similar) Higher is stricter:"
" fewer, more confident assignments."
msgstr ""
"Umbral a utilizar al comparar rostros (0 = menos similar, 100 = más similar) Cuanto más alto es "
"más estricto: menos asignaciones y más seguras."

#: yaffo/background_tasks/automation_config.py:131
msgid "Assign when multiple people match"
msgstr "Asignar cuando varias personas coinciden"

#: yaffo/background_tasks/automation_config.py:133
msgid ""
"When on, a face matching more than one person above the threshold is assigned to the highest-"
"scoring match. When off, ambiguous faces are left unassigned."
msgstr ""
"Cuando está activado, una cara que coincida con más de una persona por encima del umbral se "
"asigna a la coincidencia con mayor puntuación. Cuando está desactivado, las caras ambiguas quedan"
" sin asignar."

#: yaffo/background_tasks/automation_config.py:144
msgid "Export Location Tags"
msgstr "Exportar etiquetas de ubicación"

#: yaffo/background_tasks/automation_config.py:150
msgid "Export People Tags"
msgstr "Exportar etiquetas de personas"

#: yaffo/background_tasks/automation_config.py:156
msgid "Export Labels"
msgstr "Exportar etiquetas"

#: yaffo/background_tasks/automation_config.py:157
msgid "Write the photo's classification labels into the file's keywords."
msgstr "Escriba las etiquetas de clasificación de la fotografía en las palabras clave del archivo."

#: yaffo/background_tasks/automation_config.py:163
msgid "Export Custom Tags"
msgstr "Exportar etiquetas personalizadas"

#: yaffo/background_tasks/automation_config.py:164
msgid "Write the photo's manual tags (name, or name: value) into the file's keywords."
msgstr ""
"Escriba las etiquetas manuales de la foto (nombre o nombre: valor) en las palabras clave del "
"archivo."

#: yaffo/background_tasks/automation_config.py:170
msgid "Export Favorite"
msgstr "Exportar favorito"

#: yaffo/background_tasks/automation_config.py:171
msgid "Write a \"Favorite\" keyword into the file when the photo is marked a favorite."
msgstr "Escriba una palabra clave \"Favorito\" en el archivo cuando la foto esté marcada como favorita."

#: yaffo/background_tasks/automation_config.py:179
msgid "Reuse a nearby photo's name"
msgstr "Reutilizar el nombre de una foto cercana"

#: yaffo/background_tasks/automation_config.py:181
msgid ""
"Copy the location name of the closest already-named photo within the radius below. Free, offline,"
" and keeps your own naming."
msgstr ""
"Copie el nombre de la ubicación de la foto más cercana con nombre dentro del radio a "
"continuación. Gratis, sin conexión y mantiene tu propio nombre."

#: yaffo/background_tasks/automation_config.py:189
msgid "Nearby radius"
msgstr "Radio cercano"

#: yaffo/background_tasks/automation_config.py:191
msgid ""
"How close an already-named photo must be to copy its name. Larger values reuse names more "
"aggressively and make fewer online lookups."
msgstr ""
"Qué tan cerca debe estar una foto ya nombrada para copiar su nombre. Los valores más grandes "
"reutilizan los nombres de manera más agresiva y realizan menos búsquedas en línea."

#: yaffo/background_tasks/automation_config.py:201
msgid "Look up name online (OpenStreetMap)"
msgstr "Buscar nombre en línea (OpenStreetMap)"

#: yaffo/background_tasks/automation_config.py:203
msgid ""
"When no nearby photo is named, reverse-geocode the coordinates via OpenStreetMap Nominatim "
"(throttled to ~1 request/second)."
msgstr ""
"Cuando no se nombre ninguna foto cercana, geocodificar las coordenadas a través de OpenStreetMap "
"Nominatim (limitado a ~1 solicitud/segundo)."

#: yaffo/background_tasks/automation_config.py:211
msgid "Overwrite existing location names"
msgstr "Sobrescribir nombres de ubicaciones existentes"

#: yaffo/background_tasks/automation_config.py:212
msgid "When off, photos that already have a location name are left untouched."
msgstr "Cuando está desactivado, las fotos que ya tienen un nombre de ubicación no se modifican."

#: yaffo/background_tasks/automation_config.py:220
msgid "Time window (minutes)"
msgstr "Ventana de tiempo (minutos)"

#: yaffo/background_tasks/automation_config.py:222
msgid ""
"A photo with no GPS borrows the coordinates of the closest-in-time GPS-tagged photo, but only if "
"it was taken within this many minutes (so coordinates aren't copied across a long gap / a "
"different place)."
msgstr ""
"Una foto sin GPS toma prestadas las coordenadas de la foto etiquetada con GPS más cercana en el "
"tiempo, pero solo si se tomó dentro de esta cantidad de minutos (por lo que las coordenadas no se"
" copian en un espacio largo o en un lugar diferente)."

#: yaffo/background_tasks/automation_config.py:236
msgid "Confidence threshold"
msgstr "Umbral de confianza"

#: yaffo/background_tasks/automation_config.py:238
msgid ""
"A photo gets a label only when the CLIP image–text similarity is at or above this confidence (0 ="
" least similar, 100 = most similar) Higher is stricter: fewer, more confident labels."
msgstr ""
"Una foto recibe una etiqueta solo cuando la similitud CLIP imagen-texto está en o por encima de "
"esta confianza (0 = menos similar, 100 = más similar). Cuanto más alto es más estricto: menos "
"etiquetas, más seguras."

#: yaffo/background_tasks/automation_config.py:249
msgid "Max labels per photo"
msgstr "Máximo de etiquetas por foto"

#: yaffo/background_tasks/automation_config.py:250
msgid "At most this many labels are kept per photo (the highest-scoring ones)."
msgstr "Como máximo se guardan esta cantidad de etiquetas por foto (las de mayor puntuación)."

#: yaffo/db/models.py:392 yaffo/routes/utilities/run_history.py:104
msgid "File sync"
msgstr "Sincronización de archivos"

#: yaffo/db/models.py:393
msgid "Reconcile the photo index with the files on disk."
msgstr "Concilie el índice de fotografías con los archivos del disco."

#: yaffo/db/models.py:396
msgid "Auto-assign faces"
msgstr "Asignar caras automáticamente"

#: yaffo/db/models.py:398
msgid ""
"When a photo is indexed, assign each detected face to the one person it matches above the "
"threshold."
msgstr ""
"Cuando se indexa una foto, asigna cada rostro detectado a la persona con la que coincide por "
"encima del umbral."

#: yaffo/db/models.py:403
msgid "Export photo tag"
msgstr "Exportar etiqueta de foto"

#: yaffo/db/models.py:405
msgid "When a photo is modified, write its people and/or location tags back into the photo file."
msgstr ""
"Cuando se modifica una foto, escriba sus etiquetas de personas y/o ubicación nuevamente en el "
"archivo de la foto."

#: yaffo/db/models.py:410
msgid "Assign location name"
msgstr "Asignar nombre de ubicación"

#: yaffo/db/models.py:412
msgid ""
"When a photo is indexed, name its location from GPS — reuse a nearby named photo's name, then "
"fall back to an OpenStreetMap lookup."
msgstr ""
"Cuando se indexa una foto, nombre su ubicación desde el GPS: reutilice el nombre de una foto "
"cercana y luego recurra a una búsqueda en OpenStreetMap."

#: yaffo/db/models.py:417
msgid "Geotag from neighbors"
msgstr "Geoetiqueta de vecinos"

#: yaffo/db/models.py:419
msgid ""
"When a photo is indexed, give a GPS-less photo the coordinates of the closest-in-time photo that "
"has GPS (e.g. a camera shot taken alongside phone shots)."
msgstr ""
"Cuando se indexa una foto, proporcione a una foto sin GPS las coordenadas de la foto más cercana "
"en el tiempo que tenga GPS (por ejemplo, una toma de cámara tomada junto con tomas de teléfono)."

#: yaffo/db/models.py:425
msgid "Classify labels"
msgstr "Clasificar etiquetas"

#: yaffo/db/models.py:427
msgid ""
"When a photo is indexed, label it with the subjects, scenes, and activities it matches from your "
"label vocabulary (offline CLIP image recognition)."
msgstr ""
"Cuando se indexa una foto, etiquétela con los temas, escenas y actividades que coincidan en su "
"vocabulario de etiquetas (reconocimiento de imágenes CLIP sin conexión)."

#: yaffo/db/models.py:433
msgid "Duplicate scan"
msgstr "Escaneo duplicado"

#: yaffo/db/models.py:435
msgid ""
"Scan your indexed photos for duplicates on a schedule — results appear in the Remove Duplicates "
"tool."
msgstr ""
"Escanee sus fotos indexadas en busca de duplicados según un cronograma; los resultados aparecen "
"en la herramienta Eliminar duplicados."

#: yaffo/routes/api.py:56
msgid "Send the request body as JSON."
msgstr "Envía el cuerpo de la solicitud como JSON."

#: yaffo/routes/api.py:72 yaffo/routes/media.py:51 yaffo/routes/media.py:201 yaffo/routes/media.py:221
msgid "Photo not found"
msgstr "Foto no encontrada"

#: yaffo/routes/api.py:76
msgid "Favorite must be true or false"
msgstr "Favorite debe ser true o false"

#: yaffo/routes/api.py:117 yaffo/routes/api.py:120 yaffo/routes/faces.py:472 yaffo/routes/people.py:104
#: yaffo/routes/people.py:163 yaffo/routes/people.py:190 yaffo/routes/people.py:298
#: yaffo/routes/people.py:319
msgid "Person not found"
msgstr "Persona no encontrada"

#: yaffo/routes/api.py:122 yaffo/routes/api.py:162
msgid "One or more faces are no longer available"
msgstr "Una o más caras ya no están disponibles"

#: yaffo/routes/api.py:135
#, python-format
msgid "Successfully assigned %(count)s face to %(person)s"
msgid_plural "Successfully assigned %(count)s faces to %(person)s"
msgstr[0] "Se asignó exitosamente la cara %(count)s a %(person)s"
msgstr[1] "Caras %(count)s asignadas exitosamente a %(person)s"

#: yaffo/routes/api.py:148
msgid "This face isn't assigned to anyone"
msgstr "Esta cara no está asignada a nadie"

#: yaffo/routes/api.py:152
#, python-format
msgid "Cleared %(count)s face"
msgid_plural "Cleared %(count)s faces"
msgstr[0] "%(count)s cara restablecida"
msgstr[1] "%(count)s caras restablecidas"

#: yaffo/routes/api.py:168
#, python-format
msgid "Successfully ignored %(count)s face"
msgid_plural "Successfully ignored %(count)s faces"
msgstr[0] "Cara %(count)s ignorada con éxito"
msgstr[1] "Caras %(count)s ignoradas con éxito"

#: yaffo/routes/api.py:190
msgid "Faces must contain numeric identifiers"
msgstr "Las caras deben contener identificadores numéricos."

#: yaffo/routes/api.py:195
msgid "Faces, person, and face status are required"
msgstr "Se requieren rostros, personas y estados de rostros."

#: yaffo/routes/api.py:206
msgid "Could not process faces"
msgstr "No se pudieron procesar caras"

#: yaffo/routes/api.py:282
msgid "That file or folder isn't available. It may have moved, or its drive isn't connected."
msgstr ""
"Ese archivo o carpeta no está disponible. Puede que se haya movido o que su unidad no esté "
"conectada."

#: yaffo/routes/api.py:287
msgid "Couldn't open it on this computer."
msgstr "No se pudo abrir en este ordenador."

#: yaffo/routes/assistant.py:92 yaffo/routes/pages.py:262 yaffo/routes/themes_page.py:239
#: yaffo/routes/utilities/automations.py:614 yaffo/routes/utilities/sync_services.py:273
msgid "Message is required."
msgstr "Se requiere mensaje."

#: yaffo/routes/assistant.py:95
#, python-format
msgid "Messages can be at most %(count)s characters."
msgstr "Los mensajes pueden tener como máximo %(count)s caracteres."

#: yaffo/routes/assistant.py:101 yaffo/routes/pages.py:266 yaffo/routes/themes_page.py:243
#: yaffo/routes/utilities/automations.py:618 yaffo/routes/utilities/sync_services.py:275
#, python-format
msgid "No API key configured. Add your %(provider)s API key in Settings → AI Generation."
msgstr ""
"No hay clave API configurada. Agregue su clave API %(provider)s en Configuración → Generación de "
"IA."

#: yaffo/routes/assistant.py:143
msgid ""
"Before reading a new website, Ask Yaffo asks you to allow its domain for that conversation. Page "
"contents are sent to your AI provider."
msgstr ""
"Antes de leer un sitio web nuevo, Ask Yaffo te pide que permitas su dominio para esta "
"conversación. El contenido de las páginas se envía a tu proveedor de IA."

#: yaffo/routes/assistant.py:146
msgid "Reads a photo's capture date from its file when checking a date problem, never the image itself."
msgstr ""
"Lee la fecha de captura de una foto desde su archivo al comprobar un problema de fecha, nunca de "
"la imagen en sí."

#: yaffo/routes/assistant.py:147
msgid "The photos in the album stay in your library."
msgstr "Las fotos del álbum permanecen en tu biblioteca."

#: yaffo/routes/assistant.py:148
msgid "Their faces become unassigned; the photos stay in your library."
msgstr "Sus rostros quedan sin asignar; las fotos permanecen en tu biblioteca."

#: yaffo/routes/assistant.py:150
msgid ""
"Hides unassigned faces you don't want to name, such as strangers in the background, from "
"Unassigned Faces. Assigned faces are never ignored."
msgstr ""
"Oculta los rostros sin asignar que no quieras nombrar, como desconocidos en el fondo, de Rostros "
"sin asignar. Los rostros asignados nunca se ignoran."

#: yaffo/routes/assistant.py:153
msgid ""
"Puts ignored faces back in Unassigned Faces so they can be assigned to people. Faces that aren't "
"ignored are left alone."
msgstr ""
"Devuelve los rostros ignorados a Rostros sin asignar para que puedan asignarse a personas. Los "
"rostros que no están ignorados no se modifican."

#: yaffo/routes/assistant.py:156
msgid ""
"A birthdate decides which of a person's faces are compared with each other by age, so matching "
"for that person is rebuilt."
msgstr ""
"Una fecha de nacimiento determina cuáles de los rostros de una persona se comparan entre sí por "
"edad, por lo que la coincidencia para esa persona se reconstruye."

#: yaffo/routes/assistant.py:159
msgid "Photos only get a new label when they're classified again; the assistant can start that too."
msgstr ""
"Las fotos solo reciben una nueva etiqueta cuando se clasifican de nuevo; el asistente también "
"puede iniciar eso."

#: yaffo/routes/assistant.py:160
msgid "Every photo loses that label."
msgstr "Cada foto pierde esa etiqueta."

#: yaffo/routes/assistant.py:162
msgid "Stops a pending or running job, as its Cancel button does. Work already done stays done."
msgstr ""
"Detiene un trabajo pendiente o en ejecución, como lo hace su botón Cancelar. El trabajo ya "
"realizado permanece hecho."

#: yaffo/routes/assistant.py:163
msgid "Their faces are detected again, so people assigned to them are removed."
msgstr "Sus rostros se detectan de nuevo, por lo que se eliminan las personas asignadas a ellos."

#: yaffo/routes/assistant.py:165
msgid ""
"Writes missing face crops and video posters again from your photos and videos. Faces keep their "
"people; nothing is re-detected."
msgstr ""
"Vuelve a escribir los recortes de caras y los pósteres de vídeos que faltan a partir de tus fotos"
" y vídeos. Las caras conservan sus personas; no se vuelve a detectar nada."

#: yaffo/routes/assistant.py:168
msgid ""
"Takes a face off the person it's assigned to, e.g. a wrong match. The face goes back to "
"Unassigned Faces; the photo and the person stay."
msgstr ""
"Quita un rostro de la persona a la que está asignado, por ejemplo, una coincidencia incorrecta. "
"El rostro vuelve a Rostros sin asignar; la foto y la persona permanecen."

#: yaffo/routes/assistant.py:171
msgid ""
"Combines two people who are really the same person: every face of one moves to the other, and the"
" emptied one is deleted."
msgstr ""
"Combina dos personas que en realidad son la misma: cada rostro de una se traslada a la otra, y la"
" que queda vacía se elimina."

#: yaffo/routes/assistant.py:174
msgid ""
"Fixes faces whose status doesn't match their person link: assigned to someone but still listed as"
" unassigned, stuck mid-assignment, or ignored but still linked (the link is removed). Nothing is "
"re-detected."
msgstr ""
"Corrige los rostros cuyo estado no coincide con su vínculo de persona: asignados a alguien pero "
"aún listados como sin asignar, atascados a mitad de la asignación, o ignorados pero aún "
"vinculados (se elimina el vínculo). No se vuelve a detectar nada."

#: yaffo/routes/assistant.py:178
msgid ""
"Starts the chosen automation once for all media, selected media directories, files, or folders. "
"The automation may change your library or files; review its Run history for the result."
msgstr ""
"Inicia la automatización elegida una vez para todos los medios, directorios de medios "
"seleccionados, archivos o carpetas. La automatización puede cambiar tu biblioteca o tus archivos;"
" revisa su historial de ejecuciones para ver el resultado."

#: yaffo/routes/assistant.py:185
msgid "Logs"
msgstr "Registros"

#: yaffo/routes/assistant.py:186
msgid "Library contents"
msgstr "Contenido de la biblioteca"

#: yaffo/routes/assistant.py:187
msgid "Media folders"
msgstr "Carpetas de medios"

#: yaffo/routes/assistant.py:188
msgid "Background jobs"
msgstr "Trabajos en segundo plano"

#: yaffo/routes/assistant.py:189
msgid "Capture-date metadata"
msgstr "Metadatos de fecha de captura"

#: yaffo/routes/assistant.py:198
msgid "Tags and favorites"
msgstr "Etiquetas y favoritos"

#: yaffo/routes/assistant.py:199
msgid "Add tags"
msgstr "Añadir etiquetas"

#: yaffo/routes/assistant.py:200
msgid "Remove tags"
msgstr "Eliminar etiquetas"

#: yaffo/routes/assistant.py:201
msgid "Mark favorites"
msgstr "Marcar favoritos"

#: yaffo/routes/assistant.py:203 yaffo/templates/albums/_base.html:27
#: yaffo/templates/albums/_base.html:33 yaffo/templates/albums/index.html:7
#: yaffo/templates/base.html:136
msgid "Albums"
msgstr "Álbumes"

#: yaffo/routes/assistant.py:204
msgid "Create albums"
msgstr "Crear álbumes"

#: yaffo/routes/assistant.py:205
msgid "Rename albums"
msgstr "Renombrar álbumes"

#: yaffo/routes/assistant.py:206
msgid "Add photos to albums"
msgstr "Añadir fotos a álbumes"

#: yaffo/routes/assistant.py:207
msgid "Remove photos from albums"
msgstr "Eliminar fotos de álbumes"

#: yaffo/routes/assistant.py:208
msgid "Change album covers"
msgstr "Cambiar portadas de álbumes"

#: yaffo/routes/assistant.py:209
msgid "Reorder photos in albums"
msgstr "Reordenar fotos en álbumes"

#: yaffo/routes/assistant.py:210
msgid "Delete albums"
msgstr "Eliminar álbumes"

#: yaffo/routes/assistant.py:212
msgid "People and faces"
msgstr "Personas y rostros"

#: yaffo/routes/assistant.py:213
msgid "Assign faces to people"
msgstr "Asignar rostros a personas"

#: yaffo/routes/assistant.py:214
msgid "Unassign faces"
msgstr "Desasignar rostros"

#: yaffo/routes/assistant.py:215
msgid "Ignore faces"
