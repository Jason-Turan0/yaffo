#: yaffo/templates/faces/index.html:47 yaffo/templates/faces/index.html:153
msgid "or"
msgstr "o"

#: yaffo/templates/faces/index.html:48 yaffo/templates/faces/index.html:154
msgid "Ignore selected faces"
msgstr "Ignorar caras seleccionadas"

#: yaffo/templates/faces/index.html:52
