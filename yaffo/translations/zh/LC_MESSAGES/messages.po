#: yaffo/background_tasks/automation_config.py:66
msgid "Threshold"
msgstr "阈值"

#: yaffo/background_tasks/automation_config.py:67
msgid "Low finds more faces, Medium is balanced, and High keeps only more confident faces."
msgstr "低：检测更多人脸；中：均衡模式；高：仅保留置信度较高的人脸。"

#: yaffo/background_tasks/automation_config.py:73
msgid "Low"
msgstr "低"

#: yaffo/background_tasks/automation_config.py:74
msgid "More sensitive; finds more weak, small, blurry, or side-angle faces, but may add false positives."
msgstr "更灵敏；可检测更多模糊、细小、侧角或不清晰的人脸，但可能产生误报。"

#: yaffo/background_tasks/automation_config.py:78
msgid "Medium"
msgstr "中"

#: yaffo/background_tasks/automation_config.py:79
msgid "Balanced default for normal library indexing."
msgstr "适用于常规媒体库索引的均衡默认值。"

#: yaffo/background_tasks/automation_config.py:83
msgid "High"
msgstr "高"

#: yaffo/background_tasks/automation_config.py:84
msgid "Stricter; keeps fewer, more confident faces and may miss harder faces."
msgstr "更严格；仅保留置信度较高的人脸，可能会遗漏难以识别的人脸。"

#: yaffo/background_tasks/automation_config.py:90
msgid "Scan Speed"
msgstr "扫描速度"

#: yaffo/background_tasks/automation_config.py:92
msgid ""
"Fast scans quickest, Balanced keeps the default behavior, and Thorough is slower but better at "
"finding small or distant faces."
msgstr "快速：扫描最快；均衡：保持默认行为；精细：速度较慢，但更善于发现细小或远处的人脸。"

#: yaffo/background_tasks/automation_config.py:99
msgid "Fast"
msgstr "快速"

#: yaffo/background_tasks/automation_config.py:100
msgid "Faster scans that may miss small or distant faces."
msgstr "扫描速度较快，但可能遗漏细小或远处的人脸。"

#: yaffo/background_tasks/automation_config.py:104
msgid "Balanced"
msgstr "均衡"

#: yaffo/background_tasks/automation_config.py:105
msgid "Balanced default for detection quality and scan speed."
msgstr "检测质量与扫描速度的均衡默认值。"

#: yaffo/background_tasks/automation_config.py:109
msgid "Thorough"
msgstr "精细"

#: yaffo/background_tasks/automation_config.py:110
msgid "Slower scans with better detection for small or distant faces."
msgstr "扫描速度较慢，但对细小或远处的人脸有更好的检测效果。"

#: yaffo/background_tasks/automation_config.py:118
msgid "Match threshold"
msgstr "匹配阈值"

#: yaffo/background_tasks/automation_config.py:120
msgid ""
"Threshold to use when comparing faces (0 = least similar, 100 = most similar) Higher is stricter:"
" fewer, more confident assignments."
msgstr "比较面孔时使用的阈值（0 = 最不相似，100 = 最相似）越高越严格：分配更少、更有信心。"

#: yaffo/background_tasks/automation_config.py:131
msgid "Assign when multiple people match"
msgstr "多人匹配时分配"

#: yaffo/background_tasks/automation_config.py:133
msgid ""
"When on, a face matching more than one person above the threshold is assigned to the highest-"
"scoring match. When off, ambiguous faces are left unassigned."
msgstr "启用后，与超过一个人匹配且高于阈值的人脸将被分配给得分最高的匹配。关闭时，不明确的面孔将保持未分配状态。"

#: yaffo/background_tasks/automation_config.py:144
msgid "Export Location Tags"
msgstr "导出位置标签"

#: yaffo/background_tasks/automation_config.py:150
msgid "Export People Tags"
msgstr "导出人物标签"

#: yaffo/background_tasks/automation_config.py:156
msgid "Export Labels"
msgstr "出口标签"

#: yaffo/background_tasks/automation_config.py:157
msgid "Write the photo's classification labels into the file's keywords."
msgstr "将照片的分类标签写入文件的关键字中。"

#: yaffo/background_tasks/automation_config.py:163
msgid "Export Custom Tags"
msgstr "导出自定义标签"

#: yaffo/background_tasks/automation_config.py:164
msgid "Write the photo's manual tags (name, or name: value) into the file's keywords."
msgstr "将照片的手动标签（名称或名称：值）写入文件的关键字中。"

#: yaffo/background_tasks/automation_config.py:170
msgid "Export Favorite"
msgstr "导出收藏夹"

#: yaffo/background_tasks/automation_config.py:171
msgid "Write a \"Favorite\" keyword into the file when the photo is marked a favorite."
msgstr "当照片被标记为收藏时，在文件中写入“收藏”关键字。"

#: yaffo/background_tasks/automation_config.py:179
msgid "Reuse a nearby photo's name"
msgstr "重复使用附近照片的名称"

#: yaffo/background_tasks/automation_config.py:181
msgid ""
"Copy the location name of the closest already-named photo within the radius below. Free, offline,"
" and keeps your own naming."
msgstr "复制下面半径内最接近的已命名照片的位置名称。免费、离线，并保留您自己的命名。"

#: yaffo/background_tasks/automation_config.py:189
msgid "Nearby radius"
msgstr "附近半径"

#: yaffo/background_tasks/automation_config.py:191
msgid ""
"How close an already-named photo must be to copy its name. Larger values reuse names more "
"aggressively and make fewer online lookups."
msgstr "一张已经命名的照片必须有多接近才能复制它的名字。较大的值会更积极地重用名称并减少在线查找。"

#: yaffo/background_tasks/automation_config.py:201
msgid "Look up name online (OpenStreetMap)"
msgstr "在线查找名称（OpenStreetMap）"

#: yaffo/background_tasks/automation_config.py:203
msgid ""
"When no nearby photo is named, reverse-geocode the coordinates via OpenStreetMap Nominatim "
"(throttled to ~1 request/second)."
msgstr "当没有命名附近的照片时，通过 OpenStreetMap Nominatim 对坐标进行反向地理编码（限制为每秒 1 个请求）。"

#: yaffo/background_tasks/automation_config.py:211
msgid "Overwrite existing location names"
msgstr "覆盖现有位置名称"

#: yaffo/background_tasks/automation_config.py:212
msgid "When off, photos that already have a location name are left untouched."
msgstr "关闭后，已有位置名称的照片将保持不变。"

#: yaffo/background_tasks/automation_config.py:220
msgid "Time window (minutes)"
msgstr "时间窗口（分钟）"

#: yaffo/background_tasks/automation_config.py:222
msgid ""
"A photo with no GPS borrows the coordinates of the closest-in-time GPS-tagged photo, but only if "
"it was taken within this many minutes (so coordinates aren't copied across a long gap / a "
"different place)."
msgstr "没有 GPS 的照片会借用最近的带 GPS 标签的照片的坐标，但前提是该照片是在这么多分钟内拍摄的（因此坐标不会复制到很长的间隙/不同的地方）。"

#: yaffo/background_tasks/automation_config.py:236
msgid "Confidence threshold"
msgstr "置信阈值"

#: yaffo/background_tasks/automation_config.py:238
msgid ""
"A photo gets a label only when the CLIP image–text similarity is at or above this confidence (0 ="
" least similar, 100 = most similar) Higher is stricter: fewer, more confident labels."
msgstr "仅当 CLIP 图像-文本相似度等于或高于此置信度时，照片才会获得标签（0 = 最不相似，100 = 最相似）越高越严格：标签越少，置信度越高。"

#: yaffo/background_tasks/automation_config.py:249
msgid "Max labels per photo"
msgstr "每张照片的最大标签数"

#: yaffo/background_tasks/automation_config.py:250
msgid "At most this many labels are kept per photo (the highest-scoring ones)."
msgstr "每张照片最多保留这么多标签（得分最高的标签）。"

#: yaffo/db/models.py:359
msgid "File sync"
msgstr "文件同步"

#: yaffo/db/models.py:360
msgid "Reconcile the photo index with the files on disk."
msgstr "使照片索引与磁盘上的文件保持一致。"

#: yaffo/db/models.py:363
msgid "Auto-assign faces"
msgstr "自动分配面孔"

#: yaffo/db/models.py:365
msgid ""
"When a photo is indexed, assign each detected face to the one person it matches above the "
"threshold."
msgstr "为照片建立索引时，将每张检测到的人脸分配给超过阈值的匹配人物。"

#: yaffo/db/models.py:370
msgid "Export photo tag"
msgstr "导出照片标签"

#: yaffo/db/models.py:372
msgid "When a photo is modified, write its people and/or location tags back into the photo file."
msgstr "修改照片后，将其人物和/或位置标签写回到照片文件中。"

#: yaffo/db/models.py:377
msgid "Assign location name"
msgstr "分配位置名称"

#: yaffo/db/models.py:379
msgid ""
"When a photo is indexed, name its location from GPS — reuse a nearby named photo's name, then "
"fall back to an OpenStreetMap lookup."
msgstr "当照片被索引时，通过 GPS 命名其位置 - 重复使用附近的命名照片的名称，然后回退到 OpenStreetMap 查找。"

#: yaffo/db/models.py:384
msgid "Geotag from neighbors"
msgstr "来自邻居的地理标记"

#: yaffo/db/models.py:386
msgid ""
"When a photo is indexed, give a GPS-less photo the coordinates of the closest-in-time photo that "
"has GPS (e.g. a camera shot taken alongside phone shots)."
msgstr "当照片被索引时，为无 GPS 的照片提供最近的有 GPS 的照片的坐标（例如，相机拍摄的照片与手机拍摄的照片）。"

#: yaffo/db/models.py:392
msgid "Classify labels"
msgstr "对标签进行分类"

#: yaffo/db/models.py:394
msgid ""
"When a photo is indexed, label it with the subjects, scenes, and activities it matches from your "
"label vocabulary (offline CLIP image recognition)."
msgstr "当照片被索引时，使用与标签词汇（离线 CLIP 图像识别）相匹配的主题、场景和活动来标记它。"

#: yaffo/db/models.py:400
msgid "Duplicate scan"
msgstr "重复扫描"

#: yaffo/db/models.py:402
msgid ""
"Scan your indexed photos for duplicates on a schedule — results appear in the Remove Duplicates "
"tool."
msgstr "按计划扫描索引照片中的重复项 - 结果显示在“删除重复项”工具中。"

