msgstr "您之前忽略的人脸会加入分组，并标记为“已忽略”。"

#: yaffo/templates/faces/index.html:123
msgid "Include ignored faces"
msgstr "包含已忽略的人脸"

#: yaffo/templates/faces/index.html:129
msgid "Group by"
msgstr "分组依据"

#: yaffo/templates/faces/index.html:139
msgid "Similarity"
msgstr "相似"

#: yaffo/templates/faces/index.html:144
msgid "Similarity Threshold"
msgstr "相似度阈值"

#: yaffo/templates/faces/index.html:151
msgid "Faces to analyze"
