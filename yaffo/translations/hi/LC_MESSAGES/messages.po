msgstr "एक पीढ़ी पहले से ही चल रही है."

#: yaffo/routes/pages.py:302
msgid "Version is not ready to publish."
msgstr "संस्करण प्रकाशित करने के लिए तैयार नहीं है."

#: yaffo/routes/people.py:25
msgid "Gender must be male, female, or not specified"
msgstr "लिंग पुरुष, महिला या निर्दिष्ट नहीं होना चाहिए"

#: yaffo/routes/people.py:62 yaffo/routes/people.py:93 yaffo/routes/people.py:124
msgid "Name is required"
msgstr "नाम आवश्यक है"

#: yaffo/routes/people.py:68 yaffo/routes/people.py:100 yaffo/routes/people.py:133
#, python-format
msgid "Person '%(name)s' already exists"
msgstr "व्यक्ति '%(name)s' पहले से ही मौजूद है"

#: yaffo/routes/people.py:81
#, python-format
msgid "Added %(name)s"
msgstr "जोड़ा %(name)s"

#: yaffo/routes/people.py:153
msgid "Birthdate must be YYYY-MM-DD"
msgstr "जन्मतिथि YYYY-MM-DD होनी चाहिए"

#: yaffo/routes/people.py:166
#, python-format
msgid "Updated '%(name)s'"
msgstr "अपडेट किया गया'%(name)s'"

#: yaffo/routes/people.py:168
#, python-format
msgid "Renamed '%(old_name)s' to '%(name)s'"
msgstr "नाम बदला गया%(old_name)s' को '%(name)s'"

#: yaffo/routes/people.py:204
#, python-format
msgid "Deleted %(name)s"
msgstr "हटाए गए %(name)s"

#: yaffo/routes/people.py:302
msgid "No faces selected"
msgstr "कोई चेहरा चयनित नहीं"

#: yaffo/routes/people.py:326
msgid "Person updated"
msgstr "व्यक्ति अद्यतन किया गया"

