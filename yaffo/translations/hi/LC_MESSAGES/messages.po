msgstr "टैग नाम आवश्यक है"

#: yaffo/routes/pages.py:105 yaffo/routes/pages.py:131 yaffo/templates/pages/design.html:18
msgid "Untitled Page"
msgstr "शीर्षकहीन पृष्ठ"

#: yaffo/routes/pages.py:242 yaffo/routes/themes_page.py:239 yaffo/routes/utilities/automations.py:618
msgid "Message is required."
msgstr "संदेश आवश्यक है."

#: yaffo/routes/pages.py:246 yaffo/routes/themes_page.py:243 yaffo/routes/utilities/automations.py:622
#, python-format
msgid "No API key configured. Add your %(provider)s API key in Settings → AI Generation."
msgstr ""
"कोई API कुंजी कॉन्फ़िगर नहीं की गई. आपका जोड़ें %(provider)s सेटिंग्स → एआई जेनरेशन में एपीआई "
"कुंजी।"

#: yaffo/routes/pages.py:260 yaffo/routes/themes_page.py:235 yaffo/routes/utilities/automations.py:615
