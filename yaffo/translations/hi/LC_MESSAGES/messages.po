msgstr "एंडपॉइंट"

#: yaffo/templates/utilities/sync_service.html:211
msgid "Found in the code. Nothing else can be called. You approve this list when you publish."
msgstr ""
"कोड में मिले। इनके अलावा कुछ भी कॉल नहीं किया जा सकता। प्रकाशित करते समय आप इस सूची को मंज़ूरी "
"देते हैं।"

#: yaffo/templates/utilities/sync_service.html:217
msgid "Reads"
msgstr "रीड"

#: yaffo/templates/utilities/sync_service.html:217
msgid "Writes"
msgstr "राइट"

#: yaffo/templates/utilities/sync_service.html:222
msgid "No web calls yet."
msgstr "अभी तक कोई वेब कॉल नहीं।"

#: yaffo/templates/utilities/sync_service.html:227
msgid "Differs from the published version."
msgstr "प्रकाशित संस्करण से अलग है।"

#: yaffo/templates/utilities/sync_service.html:230
msgid "No code yet."
msgstr "अभी तक कोई कोड नहीं।"

