msgid "or"
msgstr "oder"

#: yaffo/templates/faces/index.html:55 yaffo/templates/faces/index.html:204
msgid "Ignore selected faces"
msgstr "Ausgewählte Gesichter ignorieren"

#: yaffo/templates/faces/index.html:59
