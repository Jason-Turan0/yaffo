#: yaffo/templates/utilities/sync_peer_filter.html:45
#, python-format
msgid ""
"From %(device)s › %(share)s. Photos the device adds later that match are "
"imported too."
msgstr ""
"Depuis %(device)s › %(share)s. Les photos ajoutées ultérieurement par "
"l’appareil et qui correspondent seront également importées."

#: yaffo/templates/utilities/sync_peer_filter.html:51
msgid ""
"Choose at least one filter. To import the whole share, pick Everything in"
