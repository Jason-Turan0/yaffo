#: yaffo/templates/utilities/sync_service.html:55
#, python-format
msgid ""
"%(num)d sync uses this service. If the new version can call more than "
"before, it asks for your approval again before it runs."
msgid_plural ""
"%(num)d syncs use this service. If the new version can call more than "
"before, they ask for your approval again before they run."
msgstr[0] ""
"%(num)d synchronisation utilise ce service. Si la nouvelle version peut "
"appeler davantage de choses qu’auparavant, elle vous demandera à nouveau "
"votre autorisation avant de s’exécuter."
msgstr[1] ""
"%(num)d synchronisations utilisent ce service. Si la nouvelle version "
"peut appeler davantage de choses qu’auparavant, elles vous demanderont à "
"nouveau votre autorisation avant de s’exécuter."

