#!/bin/bash
#
# Pre-commit hook to prevent accidental commit of API keys and secrets
#

# Patterns to search for (case-insensitive)
PATTERNS=(
    "sk-ant-[a-zA-Z0-9_-]+"           # Anthropic API key
    "sk-[a-zA-Z0-9]{48}"              # OpenAI API key
    "ANTHROPIC_API_KEY\s*=\s*['\"]?sk-"
    "OPENAI_API_KEY\s*=\s*['\"]?sk-"
    "api[_-]?key\s*[:=]\s*['\"]?[a-zA-Z0-9_-]{20,}"
    "secret[_-]?key\s*[:=]\s*['\"]?[a-zA-Z0-9_-]{20,}"
)

# Files to always skip
SKIP_FILES=(
    ".env.example"
    "pre-commit"
    "*.md"
)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

FOUND_SECRETS=0

for FILE in $STAGED_FILES; do
    # Skip binary files
    if file "$FILE" | grep -q "binary"; then
        continue
    fi

    # Skip allowed files
    SKIP=0
    for SKIP_PATTERN in "${SKIP_FILES[@]}"; do
        if [[ "$FILE" == $SKIP_PATTERN ]]; then
            SKIP=1
            break
        fi
    done

    if [ $SKIP -eq 1 ]; then
        continue
    fi

    # Check each pattern
    for PATTERN in "${PATTERNS[@]}"; do
        if grep -qE "$PATTERN" "$FILE" 2>/dev/null; then
            echo "ERROR: Potential secret found in $FILE"
            echo "  Pattern matched: $PATTERN"
            echo ""
            grep -nE "$PATTERN" "$FILE" | head -3
            echo ""
            FOUND_SECRETS=1
        fi
    done
done

if [ $FOUND_SECRETS -eq 1 ]; then
    echo "=========================================="
    echo "COMMIT REJECTED: Potential secrets detected"
    echo "=========================================="
    echo ""
    echo "If this is a false positive, you can:"
    echo "  1. Add the file to SKIP_FILES in .git/hooks/pre-commit"
    echo "  2. Use 'git commit --no-verify' to bypass (not recommended)"
    echo ""
    exit 1
fi

exit 0