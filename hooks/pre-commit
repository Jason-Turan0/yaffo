#!/bin/bash
#
# Pre-commit hook to prevent accidental commit of API keys and secrets.
#
# Scans the staged changes with gitleaks (https://github.com/gitleaks/gitleaks),
# using the repository's .gitleaks.toml. Without gitleaks it falls back to a
# smaller built-in pattern list. Install it with: brew install gitleaks
#
# A false positive can be allowed with a trailing "gitleaks:allow" comment on
# the line, or a path allowlist in .gitleaks.toml.
#

ROOT="$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose \
            --config "$ROOT/.gitleaks.toml" "$ROOT"; then
        echo ""
        echo "=========================================="
        echo "COMMIT REJECTED: Potential secrets detected"
        echo "=========================================="
        echo ""
        echo "Keep the value out of the repository (an environment variable, the OS"
        echo "keychain, or a build-time stamp). If this is a false positive, end the"
        echo "line with a 'gitleaks:allow' comment or allowlist it in .gitleaks.toml."
        echo "'git commit --no-verify' bypasses the check (not recommended)."
        exit 1
    fi
    exit 0
fi

echo "gitleaks not installed; using the fallback scan (brew install gitleaks)." >&2
exec "$ROOT/hooks/lib/secret-scan.sh"
