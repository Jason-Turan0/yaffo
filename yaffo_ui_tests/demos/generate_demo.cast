[0.000, "o", "\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[0.013, "o", "\u001b[1;33m# The AI will:\u001b[0m\r\n"]
[1.011, "o", "\u001b[1;33m#   1. Read the spec\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m#   2. Read the app's source code (read-only, scoped access)\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m#   3. Browse the live app with a real browser\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;33m#   4. Generate TypeScript Playwright tests\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m#   5. Type-check and run them\u001b[0m\r\n"]
[1.011, "o", "\r\n"]
