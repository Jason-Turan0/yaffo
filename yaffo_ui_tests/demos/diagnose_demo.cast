[2.010, "o", "\u001b[1;33m# The healer will:\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;33m#   1. Spin up an isolated Flask server\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m#   2. Run the Playwright test and capture the failure\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m#   3. Use AI to triage: is it a test bug or an app bug?\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;33m#   4. Browse the live app and read the source code\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;33m#   5. Fix the broken selector and re-run the test\u001b[0m\r\n"]
[1.012, "o", "\r\n"]
