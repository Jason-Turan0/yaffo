[2.010, "o", "\u001b[1;33m# Every test uses a beforeEach that waits for the .photo-grid selector:\u001b[0m\r\n"]
[1.011, "o", "\r\n"]
[0.016, "o", "  test.beforeEach(async ({ page }) => {\r\n    await page.goto('/');\r\n    await expect(page.locator('.photo-grid')).toBeVisible();\r\n    await expect(page.locator('.photo-card').first()).toBeVisible();\r\n  });\r\n"]
