[0.010, "o", "\u001b[1;33m# Our photo gallery spec includes a pagination test.\u001b[0m\r\n"]
[1.009, "o", "\u001b[1;33m# It sets page-size=10 and verifies navigation works.\u001b[0m\r\n"]
