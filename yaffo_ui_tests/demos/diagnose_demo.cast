[2.008, "o", "\u001b[1;33m# The healer will:\u001b[0m\r\n"]
[1.009, "o", "\u001b[1;33m#   1. Spin up an isolated Flask server with the buggy code\u001b[0m\r\n"]
[1.010, "o", "\u001b[1;33m#   2. Run the Playwright test and capture the failure\u001b[0m\r\n"]
[1.009, "o", "\u001b[1;33m#   3. Use AI to triage: is it a test bug or an app bug?\u001b[0m\r\n"]
