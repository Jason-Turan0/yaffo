[0.001, "o", "\u001b[1;33m# Now we introduce a bug: rename 'page-size' → 'PAGE_SIZE'.\u001b[0m\r\n"]
[1.011, "o", "\u001b[1;33m# The frontend still sends ?page-size=10, but the backend\u001b[0m\r\n"]
[1.012, "o", "\u001b[1;33m# will ignore it and default to showing 25 photos.\u001b[0m\r\n"]
