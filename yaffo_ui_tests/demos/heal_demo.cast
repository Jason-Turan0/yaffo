[0.410, "o", "\b\u001b[0m \b\u001b[?2004l\r\r\n"]
[0.013, "o", "\r\n\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  Step 1: The working test suite — all tests passing\u001b[0m\r\n\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[1.012, "o", "\u001b[1;33m# Every test uses a beforeEach that waits for the .photo-grid selector:\u001b[0m\r\n"]
[1.011, "o", "\r\n"]
[0.006, "o", "  test.beforeEach(async ({ page }) => {\r\n    await page.goto('/');\r\n    await expect(page.locator('.photo-grid')).toBeVisible();\r\n    await expect(page.locator('.photo-card').first()).toBeVisible();\r\n  });\r\n"]
[1.009, "o", "\r\n\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\u001b[1m  Step 2: Break a selector\u001b[0m\r\n"]
[0.000, "o", "\u001b[0;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m\r\n\r\n"]
[1.009, "o", "\u001b[1;33m# Renaming the selector: .photo-grid → .gallery-grid\u001b[0m\r\n"]
[1.008, "o", "\u001b[1;33m# This class doesn't exist in the app — every test will fail.\u001b[0m\r\n"]
[1.008, "o", "\r\n"]
[1.019, "o", "\u001b[0;31mSelector broken!\u001b[0m\r\n\r\n"]
[0.004, "o", "  test.beforeEach(async ({ page }) => {\r\n    await page.goto('/');\r\n    await expect(page.locator('.gallery-grid')).toBeVisible();\r\n    await expect(page.locator('.photo-card').first()).toBeVisible();\r\n  });\r\n"]
[1.007, "o", "\r\n\u001b[1;33m# Re-running the same tests with the broken selector...\u001b[0m\r\n"]
