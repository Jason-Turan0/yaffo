{
  "name": "yaffo-ui-tests",
  "version": "0.1.0",
  "description": "AI-augmented UI testing framework for Yaffo using Playwright + MCP",
  "type": "module",
  "scripts": {
    "generate": "tsx lib/test_generator/index.ts",
    "generate:test": "tsx lib/test_generator/index.ts --run-tests",
    "generate:test:gemini": "tsx lib/test_generator/index.ts -m gemini-2.5-pro --run-tests",
    "test": "BASE_URL=http://127.0.0.1:5002 playwright test",
    "seed:build": "tsx lib/services/isolated_runner.ts --build-seed --peer",
    "test:spec": "tsx scripts/test_spec.ts",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "download:obama": "tsx scripts/download_obama_gallery_photos.ts",
    "isolatedEnvironment:start": "tsx lib/services/isolated_runner.ts --port 5002",
    "isolatedEnvironment:start:sharing": "tsx lib/services/isolated_runner.ts --port 5002 --peer",
    "test:heal": "tsx lib/test_generator/heal_test.ts",
    "test:heal:repo": "tsx lib/test_generator/heal_repo.ts",
    "analyze": "tsx lib/cli/analyze.ts",
    "lint": "eslint lib/ generated_tests/",
    "typecheck": "tsc --noEmit",
    "logs": "tsx scripts/browse_api_logs.ts",
    "validate:specs": "tsx scripts/validate_specs.ts",
    "docker:build:mcp-filesystem": "docker build -t yaffo-mcp-filesystem:latest docker/mcp-filesystem"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@ai-sdk/deepseek": "^3.0.19",
    "@ai-sdk/google": "^4.0.31",
    "@ai-sdk/openai": "^4.0.27",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@ai-sdk/xai": "^4.0.25",
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@modelcontextprotocol/server-filesystem": "^2025.12.18",
    "@playwright/test": "^1.49.0",
    "ai": "^7.0.47",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "lodash": "^4.17.23",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
