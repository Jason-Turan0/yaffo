{
  "name": "yaffo-ui-tests",
  "version": "0.1.0",
  "description": "AI-augmented UI testing framework for Yaffo using Playwright + MCP",
  "type": "module",
  "scripts": {
    "generate": "tsx lib/test_generator/index.ts",
    "generate:test": "tsx lib/test_generator/index.ts --run-tests",
    "generate:test:gemini": "tsx lib/test_generator/index.ts -m gemini-2.5-pro --run-tests",
    "test": "BASE_URL=http://127.0.0.1:5001 playwright test",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "isolatedEnvironment:start": "tsx lib/services/isolated_runner.ts ",
    "test:heal": "tsx lib/test_generator/heal_test.ts",
    "analyze": "tsx lib/cli/analyze.ts",
    "regenerate": "tsx lib/cli/regenerate.ts",
    "validate": "tsx lib/cli/validate-specs.ts",
    "lint": "eslint lib/ generated_tests/",
    "typecheck": "tsc --noEmit",
    "logs": "tsx scripts/browse_api_logs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.38",
    "@ai-sdk/google": "^3.0.22",
    "@anthropic-ai/sdk": "^0.71.2",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@modelcontextprotocol/server-filesystem": "^2025.12.18",
    "@playwright/test": "^1.49.0",
    "ai": "^6.0.77",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "lodash": "^4.17.23",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
