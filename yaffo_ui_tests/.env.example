# API key for the model provider you use — only the matching provider's key
# is required (the healer picks the provider from the model alias).
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
MOONSHOT_API_KEY=sk-...
XAI_API_KEY=

# Application base URL
BASE_URL=http://localhost:5000

# Model alias generation and healing use when no --model flag is given
# (any alias from the Supported Models table in the README)
MODEL_ALIAS=claude-sonnet-5

# Model-turn budget per test file for auto-heal (default: 50).
# The healer tells the model this budget and warns it when few turns remain.
HEAL_MAX_ITERATIONS=50

# Self-healing configuration
AUTO_HEAL_ENABLED=true
HEALING_CONFIDENCE_THRESHOLD=0.8

# Set to 'true' in CI environment
CI=false